# The live-presence counter in the footer, and the only thing on this
# site that talks to a server. Everything else is a static file.
#
# Copy to .env.local for local work, and set the same names in the
# hosting project's environment (on Vercel: Project → Settings →
# Environment Variables). Nothing here is ever sent to the browser:
# api/presence.js runs on the server and returns two integers.
#
# Without these the endpoint answers 503 and the footer stays exactly
# as it is — the feature is off, not broken.

# --- Upstash Redis (required) -----------------------------------------
# Create a database at https://console.upstash.com, or connect one from
# Vercel's marketplace, and the credentials are written for you.
#
# The names below are Upstash's own, and are what to use for local work.
# On a host, api/presence.js does not insist on them: it takes ANY pair
# named <PREFIX>_REST_URL and <PREFIX>_REST_TOKEN (or the _REST_API_
# form), which covers KV_REST_API_URL / KV_REST_API_TOKEN and whatever
# prefix a marketplace connection is given. A genuine .upstash.io host
# wins if several are present.
#
# What it cannot use is a redis:// or rediss:// url on its own — KV_URL
# and REDIS_URL are the TCP endpoint, and this talks REST. If those are
# all that exist, the REST pair has to be added.
#
# Open /api/presence in a browser at any time: it answers with either
# the store it is using and the two current numbers, or exactly which
# variables are missing. It names variables, never values.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# --- Cross-origin (optional) ------------------------------------------
# Only needed when the pages and the function are not on the same
# origin — for example the site on GitHub Pages and this endpoint on
# Vercel. One origin, no wildcard, no trailing slash. Leave unset for a
# same-origin deployment.
# PRESENCE_ALLOWED_ORIGIN=https://prathameshgaikwad123.github.io

# --- Where the browser asks (optional, build time) --------------------
# Read by src/hooks/usePresence.js at build time. Defaults to the
# same-origin /api/presence, which is right whenever the pages and the
# function are deployed together. Set it to the function's absolute URL
# for the split arrangement above, and set PRESENCE_ALLOWED_ORIGIN to
# match.
# VITE_PRESENCE_ENDPOINT=https://your-project.vercel.app/api/presence
